<header class="sticky top-0 z-50 border-b border-[#eaded8] bg-paper/90 backdrop-blur-xl">
  <div class="border-b border-[#eee4de] bg-[#f8efe9] px-4 py-1.5 text-center text-[11px] tracking-[0.12em] text-text-secondary sm:text-xs">
    夏日花禮滿 NT$ 1,500 享基本運費免除 ・ 每一束花，都為重要時刻而生
  </div>
  <div class="mx-auto flex h-[4.65rem] max-w-[1280px] items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="group flex items-center gap-2.5 text-wine" aria-label="花漾生活首頁">
      <span class="grid h-9 w-9 place-items-center rounded-full border border-rose-primary/30 text-lg text-rose-primary transition group-hover:bg-rose-primary group-hover:text-white">✦</span>
      <span class="font-display text-xl font-bold tracking-[0.14em] sm:text-2xl">花漾生活</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm font-medium text-text-secondary md:flex" aria-label="主要導覽">
      <a href="/" class="transition hover:text-rose-primary">所有花禮</a>
      <a href="/#products" class="transition hover:text-rose-primary">精選花束</a>
      <a id="orders-link" href="/orders" class="transition hover:text-rose-primary" style="display: none;">我的訂單</a>
    </nav>

    <div class="flex items-center gap-2.5 text-sm">
      <a href="/cart" class="relative grid h-10 w-10 place-items-center rounded-full border border-[#e7d9d3] text-wine transition hover:border-rose-primary hover:bg-blush" aria-label="購物車">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-[19px] w-[19px]"><path stroke-linecap="round" stroke-linejoin="round" d="M3.5 4.75h1.27c.62 0 1.16.42 1.32 1.02l.25.98m0 0 1.1 4.26c.21.79.92 1.34 1.74 1.34h7.28c.71 0 1.33-.48 1.51-1.17l1.1-4.2a.75.75 0 0 0-.73-.94H6.34Zm3.2 11.7a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2Zm10.01 0a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2Z"/></svg>
        <span
          id="cart-badge"
          class="absolute -right-1 -top-1 hidden h-5 min-w-5 items-center justify-center rounded-full bg-rose-primary px-1 text-[10px] font-bold text-white"
          style="display: none;"
        ></span>
      </a>
      <div id="auth-nav" class="hidden items-center gap-3 sm:flex">
        <a href="/login" class="rounded-full bg-wine px-4 py-2 text-xs font-bold text-white transition hover:bg-rose-dark">登入</a>
      </div>
      <a href="/login" class="grid h-10 w-10 place-items-center rounded-full bg-wine text-white sm:hidden" aria-label="登入">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-[18px] w-[18px]"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 18.75a6 6 0 0 0-11.5 0m11.5 0c.38-.84.61-1.77.61-2.75a6.5 6.5 0 0 0-13 0c0 .98.22 1.91.61 2.75m11.78 0a9.75 9.75 0 1 1-11.5 0M12 12.25a3.25 3.25 0 1 0 0-6.5 3.25 3.25 0 0 0 0 6.5Z"/></svg>
      </a>
    </div>
  </div>
</header>
