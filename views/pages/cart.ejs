<div id="app">
  <div class="mb-8 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
    <div><p class="page-kicker">YOUR FLOWER BAG</p><h1 class="font-display mt-3 text-3xl font-bold tracking-[0.1em] text-wine sm:text-4xl">購物袋</h1></div>
    <a href="/" class="text-sm font-bold text-rose-primary transition hover:text-rose-dark">繼續挑選花禮 <span aria-hidden="true">→</span></a>
  </div>

  <div v-if="loading" class="flex justify-center py-24"><div class="h-9 w-9 animate-spin rounded-full border-[3px] border-rose-primary border-t-transparent"></div></div>

  <div v-else-if="items.length === 0" class="soft-card py-20 text-center">
    <div class="font-display text-5xl text-rose-primary">✿</div><h2 class="font-display mt-5 text-2xl font-bold tracking-[0.1em] text-wine">購物袋還沒有花禮</h2><p class="mt-3 text-sm text-text-secondary">去挑選一束能代表你心意的花吧。</p><a href="/" class="primary-button mt-7">開始挑選</a>
  </div>

  <template v-else>
    <div v-if="total < 500" class="mb-6 rounded-2xl border border-rose-primary/15 bg-blush/70 px-4 py-3 text-center text-sm text-rose-primary">再挑選 NT$ {{ (500 - total).toLocaleString() }}，即可享有免運配送。</div>
    <div v-else class="mb-6 rounded-2xl border border-olive/15 bg-olive-light/60 px-4 py-3 text-center text-sm text-olive">✓ 已達免運門檻，這束花將免費送到你指定的地方。</div>

    <div class="grid gap-7 lg:grid-cols-[minmax(0,1.15fr)_minmax(320px,0.65fr)] lg:gap-10">
      <section class="soft-card overflow-hidden">
        <div class="hidden grid-cols-[minmax(0,1fr)_auto_auto] gap-4 border-b border-[#eee3de] px-6 py-4 text-xs font-bold tracking-[0.08em] text-text-muted sm:grid"><span>花禮</span><span class="w-28 text-center">數量</span><span class="w-28 text-right">小計</span></div>
        <div class="divide-y divide-[#f0e6e1] px-5 sm:px-6">
          <div v-for="item in items" :key="item.id" class="flex items-center gap-3 py-5 sm:grid sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:gap-4">
            <div class="flex min-w-0 items-center gap-3"><img :src="item.product.image_url || '/images/flower-life-bouquet.png'" :alt="item.product.name" class="h-16 w-16 shrink-0 rounded-2xl object-cover sm:h-20 sm:w-20" /><div class="min-w-0"><h2 class="truncate text-sm font-bold text-wine">{{ item.product.name }}</h2><p class="mt-1 text-sm text-rose-primary">NT$ {{ item.product.price.toLocaleString() }}</p><button @click="confirmDelete(item.id)" class="mt-2 text-xs text-text-muted underline-offset-2 transition hover:text-rose-primary hover:underline">移除花禮</button></div></div>
            <div class="ml-auto flex items-center rounded-full border border-[#dfd0ca] bg-paper p-1 sm:ml-0"><button @click="updateQuantity(item.id, item.quantity - 1)" :disabled="item.quantity <= 1" class="grid h-8 w-8 place-items-center rounded-full text-text-secondary transition hover:bg-blush disabled:opacity-35" aria-label="減少數量">−</button><span class="grid h-8 w-8 place-items-center text-xs font-bold text-wine">{{ item.quantity }}</span><button @click="updateQuantity(item.id, item.quantity + 1)" :disabled="item.quantity >= item.product.stock" class="grid h-8 w-8 place-items-center rounded-full text-text-secondary transition hover:bg-blush disabled:opacity-35" aria-label="增加數量">＋</button></div>
            <p class="hidden w-28 text-right text-sm font-bold text-text-secondary sm:block">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</p>
          </div>
        </div>
      </section>

      <aside class="h-fit lg:sticky lg:top-28"><div class="soft-card overflow-hidden"><div class="border-b border-[#eee3de] px-6 py-5"><h2 class="font-display text-xl font-bold tracking-[0.08em] text-wine">訂單摘要</h2></div><div class="space-y-3 px-6 py-5 text-sm"><div class="flex justify-between text-text-secondary"><span>商品小計</span><span>NT$ {{ total.toLocaleString() }}</span></div><div class="flex justify-between text-text-secondary"><span>配送運費</span><span>{{ total >= 500 ? '免運' : 'NT$ 150' }}</span></div><div class="flex items-end justify-between border-t border-[#eaded8] pt-4"><span class="font-bold text-wine">總計</span><span class="font-display text-2xl font-bold text-rose-primary">NT$ {{ (total + (total >= 500 ? 0 : 150)).toLocaleString() }}</span></div><button @click="goCheckout" class="primary-button mt-3 w-full" data-testid="cart-checkout">前往填寫配送資訊 <span aria-hidden="true">→</span></button></div></div><p class="mt-4 text-center text-xs text-text-muted">綠界科技 SSL 加密交易</p></aside>
    </div>
  </template>

  <div v-if="confirmVisible" class="fixed inset-0 z-[60] flex items-center justify-center px-4">
    <div class="absolute inset-0 bg-wine/45 backdrop-blur-sm" @click="confirmVisible = false"></div>
    <div class="relative w-full max-w-sm rounded-3xl bg-paper p-7 text-center shadow-2xl"><span class="grid mx-auto h-11 w-11 place-items-center rounded-full bg-blush text-xl text-rose-primary">✦</span><h3 class="font-display mt-4 text-xl font-bold tracking-[0.08em] text-wine">移除這束花？</h3><p class="mt-2 text-sm leading-6 text-text-secondary">移除後仍可隨時再次選購。</p><div class="mt-6 flex gap-3"><button @click="confirmVisible = false" class="flex-1 rounded-full border border-[#dfd0ca] px-4 py-2.5 text-sm font-bold text-text-secondary transition hover:bg-blush">保留</button><button @click="handleDelete" class="flex-1 rounded-full bg-wine px-4 py-2.5 text-sm font-bold text-white transition hover:bg-rose-dark">確定移除</button></div></div>
  </div>
</div>
