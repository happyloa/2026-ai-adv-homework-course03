<div id="app" data-product-id="<%= productId %>">
  <div v-if="loading" class="flex justify-center py-24">
    <div class="h-9 w-9 animate-spin rounded-full border-[3px] border-rose-primary border-t-transparent"></div>
  </div>

  <div v-else-if="notFound" class="soft-card mx-auto max-w-xl py-20 text-center">
    <div class="font-display text-5xl text-rose-primary">✿</div>
    <h1 class="font-display mt-5 text-2xl font-bold tracking-[0.1em] text-wine">這束花已經離開花園</h1>
    <p class="mt-3 text-sm text-text-secondary">也許它正在成為某個人的美好心意。</p>
    <a href="/" class="primary-button mt-7">回到所有花禮</a>
  </div>

  <template v-else-if="product">
    <nav class="mb-6 flex items-center gap-2 text-xs text-text-muted" aria-label="麵包屑">
      <a href="/" class="transition hover:text-rose-primary">所有花禮</a><span>/</span><span class="truncate text-text-secondary">{{ product.name }}</span>
    </nav>

    <section class="grid gap-8 lg:grid-cols-[1.06fr_0.94fr] lg:gap-14">
      <div class="relative">
        <div class="absolute -inset-3 rounded-[2rem] bg-blush/70"></div>
        <div class="relative overflow-hidden rounded-[1.75rem] bg-wine shadow-[0_22px_48px_rgba(49,25,35,0.18)]">
          <img :src="product.image_url || '/images/flower-life-bouquet.png'" :alt="product.name" class="aspect-[4/4.35] w-full object-cover" />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/45 to-transparent px-5 pb-5 pt-16 text-white">
            <div class="flex items-end justify-between gap-4">
              <div><p class="text-[10px] font-bold tracking-[0.17em] text-white/75">FLOWER LIFE COLLECTION</p><p class="mt-1 text-sm font-medium">花藝師手工設計・新鮮配送</p></div>
              <span class="rounded-full border border-white/30 bg-white/10 px-3 py-1.5 text-xs backdrop-blur">{{ product.stock }} 束可訂</span>
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-col justify-center py-2 lg:py-6">
        <p class="page-kicker">SEASONAL FLOWER GIFT</p>
        <h1 class="font-display mt-4 text-3xl font-bold leading-[1.45] tracking-[0.1em] text-wine sm:text-4xl">{{ product.name }}</h1>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <p class="font-display text-3xl font-bold text-rose-primary">NT$ {{ product.price.toLocaleString() }}</p>
          <span class="status-pill bg-olive-light text-olive"><span aria-hidden="true">✓</span> {{ product.stock > 0 ? '現貨可訂' : '暫時售完' }}</span>
        </div>

        <p class="mt-6 max-w-xl text-sm leading-7 text-text-secondary">{{ product.description }}</p>

        <div class="mt-7 border-y border-[#eaded8] py-5">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
              <p class="text-xs font-bold tracking-[0.12em] text-text-muted">選擇數量</p>
              <p class="mt-1 text-sm text-text-secondary">每一束皆含保鮮指南與心意小卡</p>
            </div>
            <div class="flex items-center rounded-full border border-[#dfd0ca] bg-paper p-1">
              <button @click="decrease" class="grid h-9 w-9 place-items-center rounded-full text-lg text-text-secondary transition hover:bg-blush" aria-label="減少數量">−</button>
              <span class="grid h-9 min-w-10 place-items-center text-sm font-bold text-wine">{{ quantity }}</span>
              <button @click="increase" class="grid h-9 w-9 place-items-center rounded-full text-lg text-text-secondary transition hover:bg-blush" aria-label="增加數量">＋</button>
            </div>
          </div>
        </div>

        <button @click="addToCart" :disabled="adding || product.stock <= 0" class="primary-button mt-7 w-full" data-testid="product-add-to-cart">
          <span v-if="adding" class="h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent"></span>
          <svg v-else aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.5 5h1.13c.62 0 1.15.42 1.31 1.02l.29 1.12m0 0 1.05 4.03c.2.78.91 1.32 1.72 1.32h7.28c.72 0 1.35-.49 1.52-1.18l1.05-4.2a.75.75 0 0 0-.73-.93H6.23Zm3.04 10.66a1.13 1.13 0 1 0 0 2.26 1.13 1.13 0 0 0 0-2.26Zm10.16 0a1.13 1.13 0 1 0 0 2.26 1.13 1.13 0 0 0 0-2.26Z"/></svg>
          {{ product.stock <= 0 ? '此花禮暫時售完' : (adding ? '正在放入購物袋…' : '加入購物袋') }}
        </button>

        <div class="mt-7 grid grid-cols-3 gap-2 text-center text-[11px] text-text-secondary sm:gap-4 sm:text-xs">
          <div class="rounded-2xl bg-paper/70 px-2 py-3"><p class="text-base text-rose-primary">✦</p><p class="mt-1">嚴選花材</p></div>
          <div class="rounded-2xl bg-paper/70 px-2 py-3"><p class="text-base text-rose-primary">▣</p><p class="mt-1">貼心包裝</p></div>
          <div class="rounded-2xl bg-paper/70 px-2 py-3"><p class="text-base text-olive">✓</p><p class="mt-1">安心付款</p></div>
        </div>
      </div>
    </section>
  </template>
</div>
